# Global Monorepo Git Ignore Architecture
# Reference: https://git-scm.com

# ============================================================
# Operating System Meta-Files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ============================================================
# Editors / IDEs / Local Workspace States
# ============================================================
.idea/
*.iml
*.swp
*.swo
*.suo
*.ntvs*
.vscode/*.local.json
.vscode/.history/

# ============================================================
# Environment Settings / Production Secrets
# ============================================================
next-env.d.ts
.env
.env.*
!.env.example
!.env.production
*.pem
*.key
*.crt
*.p12
*.pfx

# ============================================================
# Node / pnpm / Monorepo Package Layers
# ============================================================
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================
# Next.js / Compilation / Build Output Targets
# ============================================================
.next/
out/
dist/
build/
*.tsbuildinfo
.vercel

# ============================================================
# Coverage / SAST Engine Tool Test Artifacts
# ============================================================
htmlcov/
coverage/
.coverage*
coverage.*
.nyc_output/
.vitest/
.semgrep/
.sonar/
.lighthouseci/
test-results/
playwright-report/
blob-report/
hint-report/
.scannerwork/

# Locked to the root directory level to protect internal src/ classes and architectures
/artifacts/
/models/

*.pt
*.pth
*.onnx
*.safetensors

# ============================================================
# Docker Storage Areas
# ============================================================
docker-data/
.docker/

# ============================================================
# Runtime Logs
# ============================================================
*.log
logs/

# ============================================================
# Temporary Run Paths & Caches
# ============================================================
tmp/
temp/
.cache/
.cache-loader/
.stylelintcache

# ============================================================
# Generated Documentation / Reports
# ============================================================
/reports
/reports/**/*.html

# ============================================================
# Local Development Overrides
# ============================================================
.local/
.localhost/
