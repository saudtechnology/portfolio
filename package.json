{
	"private": true,
	"name": "saudtechnology-portfolio",
	"version": "0.0.0",
	"license": "MIT",
	"description": "SAUD TECHNOLOGY is the engineering identity and portfolio of THIAGO SAUD, focused on AI Engineering, Machine Learning, Software Architecture, Frontend Engineering, MLOps, and intelligent distributed systems.",
	"homepage": "https://saudtechnology.com",
	"keywords": [
		"saud-technology",
		"thiago-saud",
		"technology-portfolio",
		"ai-engineering",
		"mlops",
		"artificial-intelligence",
		"machine-learning",
		"generative-ai",
		"large-language-models",
		"llm",
		"rag",
		"agentic-ai",
		"multimodal-ai",
		"computer-vision",
		"software-architecture",
		"distributed-systems",
		"frontend-engineering",
		"frontend-architecture",
		"web-performance",
		"observability",
		"cloud-engineering"
	],
	"author": {
		"name": "THIAGO SAUD",
		"email": "thiago@saudtechnology.com",
		"url": "https://github.com/thiagosaud"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/saudtechnology/portfolio.git"
	},
	"bugs": {
		"url": "https://github.com/saudtechnology/portfolio/issues"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24.14.0",
		"pnpm": ">=12.4.1"
	},
	"browserslist": [
		"defaults",
		"not dead",
		"not ie 11",
		"not ios_saf <= 14.8"
	],
	"validate-branch-name": {
		"pattern": "^(main|feat|fix|docs|style|perf|test|chore|ci|revert|release|refactor|changeset-release)(/([a-z0-9.-]+))?$",
		"errorMsg": "❌ [BRANCH LINT ERROR] Branch name outside the repository standard. Use <type>/<short-description-in-kebab-case>."
	},
	"scripts": {
		"prepare": "node ./scripts/prepare-lefthook.mjs",
		"dev": "next dev --turbopack",
		"build": "rm -rf .next out && next build",
		"start": "serve out --listen 4173 --no-clipboard",
		"preview": "pnpm build && serve out --listen 4173 --no-clipboard",
		"infra:script:setup": "bash ./scripts/setup.sh",
		"infra:script:lint:check:branchname": "bash ./scripts/validate-branch-name.sh",
		"infra:script:lint:check:commitmsg": "bash ./scripts/validate-commit-message.sh",
		"infra:script:lint:check:sh": "bash ./scripts/lint-shell.sh",
		"infra:release:changeset": "changeset",
		"infra:release:changeset:status": "changeset status --verbose",
		"infra:release:changeset:pre-enter:alpha": "pnpm infra:release:changeset pre enter alpha",
		"infra:release:changeset:pre-enter:beta": "pnpm infra:release:changeset pre enter beta",
		"infra:release:changeset:pre-enter:rc": "pnpm infra:release:changeset pre enter rc",
		"infra:release:changeset:pre-exit": "pnpm infra:release:changeset pre exit",
		"infra:release:changeset:version:packages": "pnpm infra:release:changeset version",
		"infra:release:changeset:publish:packages": "pnpm build && changeset publish",
		"infra:test:workflow:ci": "act pull_request -W .github/workflows/ci.yml",
		"infra:test:workflow:cd": "act push -W .github/workflows/cd.yml -j quality",
		"infra:test:workflow:codeql": "act pull_request -W .github/workflows/codeql.yml",
		"infra:test:workflow:release": "act push -W .github/workflows/release.yml --dryrun",
		"infra:test:workflow:reusable-ci": "act pull_request -W .github/workflows/ci.yml",
		"test:report:playwright": "pnpm exec playwright show-report",
		"test:report:unit": "pnpm exec node --test --experimental-test-coverage --test-coverage-include='src/**' tests/**/*.test.mjs",
		"test:unit": "node --test tests/**/*.test.mjs",
		"test:e2e": "pnpm build && playwright test",
		"test:audit": "pnpm audit --prod",
		"test:lighthouse": "pnpm build && lhci autorun",
		"test:sast:secrets": "gitleaks-secret-scanner git --config=.gitleaks.toml --redact --verbose --exit-code=1",
		"test:sast:semgrep": "bash ./scripts/semgrep.sh",
		"test:sast:all": "pnpm test:sast:secrets && pnpm test:sast:semgrep",
		"prettier:fix": "prettier --write .",
		"markdown:fix": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --dot . --fix",
		"stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
		"eslint:fix": "eslint . --fix",
		"eslint:check": "eslint . --max-warnings 0",
		"lint:fix:all": "pnpm eslint:fix && pnpm stylelint:fix && pnpm prettier:fix && pnpm markdown:fix",
		"lint:check:all": "pnpm lint:check:branchname && pnpm eslint:check && pnpm lint:check:stylelint && pnpm lint:check:json && pnpm lint:check:yaml && pnpm lint:check:toml && pnpm infra:script:lint:check:sh && pnpm lint:check:commit && pnpm lint:check:markdown && pnpm lint:check:prettier && pnpm lint:check:code:ts",
		"lint:check:branchname": "pnpm infra:script:lint:check:branchname",
		"lint:check:commit": "pnpm infra:script:lint:check:commitmsg",
		"lint:check:markdown": "markdownlint --config .markdownlint.json --ignore-path .markdownlintignore --dot .",
		"lint:check:prettier": "prettier --check .",
		"lint:check:code:ts": "next typegen && tsc --noEmit",
		"lint:check:stylelint": "stylelint \"**/*.{css,scss}\"",
		"lint:check:hint": "hint ./out",
		"lint:check:yaml": "eslint --no-error-on-unmatched-pattern --no-warn-ignored \"**/*.{yml,yaml}\"",
		"lint:check:json": "eslint --no-error-on-unmatched-pattern --no-warn-ignored \"**/*.{json}\"",
		"lint:check:toml": "taplo lint",
		"lint:check:sh": "pnpm infra:script:lint:check:sh"
	},
	"dependencies": {
		"next": "16.3.5",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.5.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/types": "^21.2.0",
		"eslint": "^9",
		"eslint-config-next": "16.3.5",
		"eslint-config-prettier": "^10.1.8",
		"tailwindcss": "^4",
		"typescript": "^5",
		"gitleaks-secret-scanner": "^2.1.1",
		"hint": "^7.1.13",
		"lefthook": "^2.1.10",
		"markdownlint-cli": "^0.49.1",
		"prettier": "^3.9.6",
		"validate-branch-name": "^1.3.2",
		"@playwright/test": "^1.55.0",
		"serve": "^14.2.4",
		"@lhci/cli": "^0.14.0",
		"stylelint": "^16.25.0",
		"stylelint-config-standard": "^39.0.0",
		"@eslint/json": "^0.13.0",
		"eslint-plugin-yml": "^1.16.0",
		"eslint-plugin-sonarjs": "^3.0.0",
		"@taplo/cli": "^0.7.0"
	}
}
